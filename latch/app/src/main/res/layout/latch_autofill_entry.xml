<?xml version="1.0" encoding="utf-8"?>
<!--
  latch: one row in the autofill dropdown.

  Our own layout rather than android.R.layout.simple_list_item_1: a RemoteViews
  is constructed with *our* package name, so a framework layout id is looked up
  in the wrong package and inflation fails silently, leaving no dropdown at all.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/latch_autofill_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:textSize="16sp"
    android:singleLine="true"
    android:ellipsize="end" />
