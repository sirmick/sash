<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      We must be able to query all packages to get their signature;
      Theoretically, we should be able to use fingerprint from
      BeginGetCredentialRequest.callingAppInfo (/Create), but that would require too many
      changes on microG lib.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Required for hybrid sign-in (with the QRCode + bluetooth) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- latch: Syncthing runs as a subprocess of ours, and Android kills a
         background process mid-sync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Passchain"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- latch: the vault's own screens. Excluded from recents because a
             list of the sites you hold accounts on is exactly the metadata the
             random entry filenames exist to withhold. -->
        <activity
            android:name=".VaultActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:label="@string/latch_title">
            <!-- latch: pairing by QR without a camera in this app. The other
                 device scans our code with the system camera app, which opens
                 this link and hands us the peer's id. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="latch" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- latch: the ceremony behind a password entry. The system launches it
             from the entry's PendingIntent, so it is the only place a password
             leaves the vault, and always with a human in front of it. -->
        <activity
            android:name=".PasswordActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Passchain" />

        <activity
            android:name=".GetPasskeyActivity"
            android:theme="@style/Theme.AppCompat.Translucent" />
        <activity
            android:name=".CreatePasskeyActivity"
            android:theme="@style/Theme.AppCompat.Translucent" />

        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- latch: filling passwords into web forms. This is the path pane
             uses: GeckoView implements the autofill framework, so a login form
             inside an origin-locked app is filled exactly as one in any
             browser, with nothing injected and no engine hook to maintain. -->
        <service
            android:name=".LatchAutofillService"
            android:exported="true"
            android:label="@string/latch_autofill_service"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <service
            android:name=".ProviderService"
            android:banner="@string/service_description"
            android:description="@string/service_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>

            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credentialprovider" />
        </service>
    </application>

</manifest>