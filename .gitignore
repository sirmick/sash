# Build output
**/build/
**/.gradle/
__pycache__/
*.apk
*.idsig

# Fetched or generated, never committed: the Syncthing binary is 25MB a side
# and `make sync-binary` reproduces it.
latch/app/src/main/jniLibs/
latch/.syncthing-src/

# Screenshots from `make shot`
*.png
!**/src/main/res/**/*.png
# The catalogue's icons are source: without them mint.py cannot mint, so a
# fresh clone could not build a single site app. They were ignored by the rule
# above for a while, which is the kind of thing that only shows up on a clone.
!catalogue/icons/*.png
# ...and so are the copies mint.py makes of them. The rest of the minted output
# -- manifests, site.json, the surface classes -- is committed, and a tree with
# those but not the icons does not resource-link: the manifest references
# @mipmap/ic_<surface>. Committing all of it or none of it; all of it means a
# clone builds without running Python.
!probe/loader/app/src/*/res/**/*.png
